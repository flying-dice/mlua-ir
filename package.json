{
  "name": "mlua-ir-checks",
  "private": true,
  "description": "Type-checks the generated declarations against real usage: tsc for TypeScript, luau-lsp for Luau",
  "scripts": {
    "check": "bash tools/check.sh",
    "typecheck:ts": "tsc -p ts",
    "build:ts": "tstl -p ts/tsconfig.tstl.json"
  },
  "devDependencies": {
    "@typescript-to-lua/language-extensions": "1.19.0",
    "typescript": "5.9.3",
    "typescript-to-lua": "1.34.0"
  }
}
