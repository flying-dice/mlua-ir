{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": [
      "@typescript-to-lua/language-extensions"
    ]
  },
  "include": [
    "../generated/types.d.ts",
    "*.ts"
  ],
  "tstl": {
    "luaTarget": "Luau",
    "luaLibImport": "inline",
    "noImplicitSelf": true,
    "noHeader": true,
    "noResolvePaths": [
      "std:*",
      "lib:*",
      "vnd:*"
    ]
  }
}
